{
  "name": "nutritrack-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NutriTrack - Platform Presisi Intervensi Stunting & Pemantauan MBG Berbasis Komoditas Lokal Jawa Timur",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "typecheck": "npm --prefix frontend run typecheck",
    "install:all": "npm install --prefix frontend && npm install --prefix backend"
  },
  "keywords": [
    "nutritrack",
    "stunting",
    "makan-bergizi-gratis",
    "jawa-timur",
    "posyandu",
    "puskesmas",
    "kemenkes"
  ],
  "author": "NutriTrack Team",
  "license": "MIT"
}
